{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Headway",
  "version": "0.2.1",
  "identifier": "wang.frankie.headway",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev:renderer",
    "beforeBuildCommand": "pnpm build:renderer && cargo build --release -p headway-cli"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Headway",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 14, "y": 18 },
        "width": 1100,
        "height": 720,
        "minWidth": 880,
        "minHeight": 560,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "DeveloperTool",
    "shortDescription": "Keep GitHub-built apps and CLI tools current",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "files": {
        "MacOS/headway": "../target/release/headway"
      }
    }
  }
}
